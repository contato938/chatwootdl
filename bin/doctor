#!/usr/bin/env ruby

puts "\n🏥 Starting Chatwoot Production Doctor..."
puts "=========================================="

# 1. Check Environment Variables
puts "\n1. Checking Environment Variables..."
required_vars = %w[SECRET_KEY_BASE POSTGRES_HOST POSTGRES_PASSWORD POSTGRES_USERNAME REDIS_URL RAILS_ENV]
missing_vars = required_vars.select { |var| ENV[var].nil? || ENV[var].empty? }

if missing_vars.any?
  puts "❌ Missing Critical Environment Variables:"
  missing_vars.each { |var| puts "   - #{var}" }
  puts "   -> The application cannot start without these."
else
  puts "✅ All critical environment variables are present."
end

# Load Rails Environment
puts "\n2. Loading Rails Environment (this may take a moment)..."
begin
  require_relative '../config/environment'
  puts "✅ Rails environment loaded successfully."
rescue => e
  puts "❌ Failed to load Rails environment: #{e.message}"
  puts "   -> This usually indicates a syntax error in configuration files or missing dependencies."
  puts e.backtrace.take(5)
  exit 1
end

# 3. Check Database Connection
puts "\n3. Checking Database Connection..."
begin
  ActiveRecord::Base.establish_connection
  ActiveRecord::Base.connection.active?
  puts "✅ Database connection successful."
rescue => e
  puts "❌ Database connection failed: #{e.message}"
  puts "   -> Check POSTGRES_HOST, POSTGRES_USERNAME, and POSTGRES_PASSWORD."
end

# 4. Check Migrations
puts "\n4. Checking Pending Migrations..."
begin
  if ActiveRecord::Migration.check_pending!
    puts "✅ No pending migrations. Database is up to date."
  end
rescue ActiveRecord::PendingMigrationError => e
  puts "❌ Pending migrations found!"
  puts "   -> Run 'bundle exec rails db:migrate' to fix this."
rescue => e
  puts "❌ Could not check migrations: #{e.message}"
end

# 5. Check Redis
puts "\n5. Checking Redis Connection..."
begin
  # Chatwoot uses Redis.new with config from environment
  redis = Redis.new(url: ENV['REDIS_URL'])
  redis.ping
  puts "✅ Redis connection successful."
rescue => e
  puts "❌ Redis connection failed: #{e.message}"
  puts "   -> Check REDIS_URL."
end

puts "\n=========================================="
puts "🏁 Diagnosis Complete."
